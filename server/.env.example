DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chainagent
DB_PASSWORD=
DB_NAME=chainagent
TEST_DB_NAME=chainagent_test
HOST=127.0.0.1
PORT=3100
# Behind a reverse proxy: its address(es), e.g. 127.0.0.1 for nginx on this host, so login
# limits use the real client address. Leave empty when clients connect directly.
TRUST_PROXY=
# Encrypts GitLab tokens at rest: 32 random bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAINAGENT_SECRET_KEY=
